NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/ams?retryWrites=true&w=majority

CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-with-another-at-least-64-random-characters
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME_MINUTES=15

EMAIL_VERIFICATION_EXPIRES_HOURS=24

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-new-google-app-password

MAIL_FROM_NAME=SRJJ AMS
MAIL_FROM_ADDRESS=your-email@gmail.com